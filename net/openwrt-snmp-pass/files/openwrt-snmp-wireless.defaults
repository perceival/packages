#!/bin/sh

uci -q batch <<-EOT
	delete snmpd.openwrt_wireless
	set snmpd.openwrt_wireless=pass
	set snmpd.openwrt_wireless.miboid='.1.3.6.1.4.1.66510.1.10'
	set snmpd.openwrt_wireless.prog='/usr/libexec/openwrt-snmp/openwrt-snmp-pass.sh'
	set snmpd.openwrt_wireless.persist='1'
	commit snmpd
EOT

/etc/init.d/snmpd running >/dev/null 2>&1 && /etc/init.d/snmpd restart

exit 0
