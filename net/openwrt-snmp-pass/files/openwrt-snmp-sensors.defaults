#!/bin/sh

uci -q batch <<-EOT
	delete snmpd.openwrt_sensors
	set snmpd.openwrt_sensors=pass
	set snmpd.openwrt_sensors.miboid='.1.3.6.1.4.1.2021.13.16'
	set snmpd.openwrt_sensors.prog='/usr/libexec/openwrt-snmp/lm-sensors-pass.sh'
	set snmpd.openwrt_sensors.persist='1'
	commit snmpd
EOT

/etc/init.d/snmpd running >/dev/null 2>&1 && /etc/init.d/snmpd restart

exit 0
